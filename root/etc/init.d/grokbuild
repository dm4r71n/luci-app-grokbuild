#!/bin/sh /etc/rc.common
# Grok Build terminal: ttyd on a Unix socket, an authenticating proxy that
# checks the LuCI session, and stunnel for TLS on the public port.
#
#   browser --TLS--> stunnel :port --> proxy.uc 127.0.0.1:proxy_port --unix--> ttyd -> tmux
#
# Nothing secret is on any command line. The tmux session (and grok in it)
# is not stopped by stop/restart; see /usr/libexec/grokbuild/ctl.sh.

START=99
STOP=10
USE_PROCD=1

RUN=/var/run/grokbuild
INDEX=/usr/share/grokbuild/www/index.html

to_pem() {
	# $1 = x509 or pkey, $2 = source, $3 = destination
	if grep -q -- '-----BEGIN' "$2" 2>/dev/null; then
		cp "$2" "$3"
	else
		openssl "$1" -inform DER -in "$2" -out "$3" 2>/dev/null
	fi
}

prepare_tls() {
	local cert key
	config_get cert main cert
	config_get key main key
	[ -n "$cert" ] || cert=$(uci -q get uhttpd.main.cert)
	[ -n "$key" ] || key=$(uci -q get uhttpd.main.key)
	mkdir -p /etc/grokbuild
	(umask 077
	 to_pem x509 "$cert" /etc/grokbuild/tls.crt.new &&
	 to_pem pkey "$key" /etc/grokbuild/tls.key.new &&
	 mv /etc/grokbuild/tls.crt.new /etc/grokbuild/tls.crt &&
	 mv /etc/grokbuild/tls.key.new /etc/grokbuild/tls.key) && return 0
	rm -f /etc/grokbuild/tls.crt.new /etc/grokbuild/tls.key.new
	# Keep the last good pair if conversion failed.
	[ -s /etc/grokbuild/tls.crt ] && [ -s /etc/grokbuild/tls.key ]
}

add_accept() {
	echo "accept = $1:$port" >> "$RUN/stunnel.conf.new"
}

write_stunnel_conf() {
	(umask 077; : > "$RUN/stunnel.conf.new")
	cat >> "$RUN/stunnel.conf.new" <<-EOC
		; Generated by /etc/init.d/grokbuild from /etc/config/grokbuild.
		foreground = yes
		pid =
		syslog = no
		debug = 4

		[grokbuild]
	EOC
	config_list_foreach main listen add_accept
	cat >> "$RUN/stunnel.conf.new" <<-EOC
		connect = 127.0.0.1:$proxy_port
		protocol = proxy
		cert = /etc/grokbuild/tls.crt
		key = /etc/grokbuild/tls.key
		sslVersionMin = TLSv1.2
		TIMEOUTidle = 86400
	EOC
	mv "$RUN/stunnel.conf.new" "$RUN/stunnel.conf"
}

start_service() {
	local enabled port proxy_port
	config_load grokbuild
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get port main port 7682
	config_get proxy_port main proxy_port 7683

	mkdir -p "$RUN/tickets"
	chmod 700 "$RUN" "$RUN/tickets"
	[ -s "$INDEX" ] || { logger -t grokbuild "missing $INDEX"; return 1; }
	prepare_tls || { logger -t grokbuild "no usable TLS certificate"; return 1; }
	write_stunnel_conf
	grep -q '^accept' "$RUN/stunnel.conf" || echo "accept = 0.0.0.0:$port" >> "$RUN/stunnel.conf"

	# ttyd: Unix socket only, trusts the header the proxy adds. -d 3 keeps
	# errors and warnings only.
	procd_open_instance ttyd
	procd_set_param command /usr/bin/ttyd -i "$RUN/ttyd.sock" -H X-GrokBuild-User -W \
		-I "$INDEX" -d 3 /usr/libexec/grokbuild/attach.sh
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance proxy
	procd_set_param command /usr/bin/ucode /usr/share/grokbuild/proxy.uc
	procd_set_param file /etc/config/grokbuild
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance tls
	procd_set_param command /usr/bin/stunnel "$RUN/stunnel.conf"
	procd_set_param file "$RUN/stunnel.conf" /etc/grokbuild/tls.crt /etc/grokbuild/tls.key
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$RUN/ttyd.sock"
}

service_triggers() {
	procd_add_reload_trigger grokbuild
}
